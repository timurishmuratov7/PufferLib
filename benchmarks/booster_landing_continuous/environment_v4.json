{
  "schema_version": 1,
  "id": "booster_landing_continuous_environment_v4",
  "description": "Continuous booster environment with coast-centered actions and exact reward parity with the successful discrete curriculum.",
  "env_name": "booster_landing_continuous",
  "config": "config/booster_landing_continuous.ini",
  "parent_suite": "benchmarks/booster_landing_continuous/environment_v2.json",
  "action_space": {
    "effective_range": [-1.0, 1.0],
    "main_throttle": "Clamp action 0 to 0..1; nonpositive actions mean engine off.",
    "attitude": "Clamp action 1 to signed -1..1 side-thrust authority."
  },
  "reward": {
    "terminal": "Successful landing +1; any failure -1.",
    "potential": "-max(stopping-distance risk, required-fuel risk)",
    "potential_scale": 0.1,
    "gamma": 0.9999,
    "direct_step_penalty": 0.0,
    "final_clamp": [-1.0, 1.0]
  },
  "evaluation": {
    "episodes": 8192,
    "reset_seed": 100000,
    "policy_seed": 42,
    "altitude_min": 100.0,
    "altitude_max": 1500.0,
    "downward_velocity_min": 5.0,
    "downward_velocity_max": 25.0,
    "x_velocity_min": -5.0,
    "x_velocity_max": 5.0,
    "angular_velocity_min": -0.05,
    "angular_velocity_max": 0.05,
    "canonicalize_horizontal": true,
    "max_landing_x_speed": 1.0
  }
}
