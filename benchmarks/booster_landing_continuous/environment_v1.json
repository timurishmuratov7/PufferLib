{
  "schema_version": 1,
  "id": "booster_landing_continuous_environment_v1",
  "description": "Continuous-action counterpart to the frozen discrete booster environment. Physics, observations, reset distribution, reward, fuel, and touchdown criteria are retained.",
  "env_name": "booster_landing_continuous",
  "config": "config/booster_landing_continuous.ini",
  "parent_suite": "benchmarks/booster_landing/angular_velocity_005_v1.json",
  "action_space": {
    "effective_range": [-1.0, 1.0],
    "main_throttle": "Map action 0 from -1..1 to 0..1 throttle.",
    "attitude": "Clamp action 1 to signed -1..1 side-thrust authority."
  },
  "evaluation": {
    "episodes": 8192,
    "reset_seed": 100000,
    "policy_seed": 42,
    "altitude_min": 100.0,
    "altitude_max": 1500.0,
    "downward_velocity_min": 5.0,
    "downward_velocity_max": 25.0,
    "x_velocity_min": -5.0,
    "x_velocity_max": 5.0,
    "angular_velocity_min": -0.05,
    "angular_velocity_max": 0.05,
    "canonicalize_horizontal": true,
    "max_landing_x_speed": 1.0
  }
}
